# ==============================================================================
# Verity Backend Environment Variables (Authoritative Register: BE-15)
# ==============================================================================

# --- Core ---
APP_ENV=development
APP_VERSION=0.0.0
LOG_LEVEL=INFO
PORT=8000

# --- Database ---
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_STATEMENT_CACHE_SIZE=0
EXPECTED_SCHEMA_VERSION=1

# --- Storage ---
STORAGE_DIR=./data/uploads
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JWKS_URL=https://xxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# --- Gemini LLM & Embeddings ---
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GENERATION_MODEL=gemini-3.6-flash
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=50
GEMINI_RPM=12
GEMINI_MAX_RETRIES=5
DAILY_QUOTA_CEILING=1200

# --- Document Chunking ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80
CHUNK_MAX_TOKENS=900
MIN_CHARS_PER_CHUNK=40
MIN_CHARS_PER_PAGE=80

# --- Hybrid Retrieval & Confidence Gate ---
RETRIEVAL_CANDIDATES=50
RRF_K=60
RETRIEVAL_TOP_K=12
CONTEXT_CHUNKS=8
HNSW_EF_SEARCH=40
MIN_TOP_SIMILARITY=0.55
MIN_SUPPORTING_SIMILARITY=0.45
MIN_SUPPORTING_CHUNKS=2

# --- Ingestion Limits ---
MAX_UPLOAD_MB=20
MAX_PAGES=500
INGESTION_CONCURRENCY=2
INGESTION_TIMEOUT_SECONDS=600
PDF_PARSE_TIMEOUT_SECONDS=120
STORAGE_BUDGET_MB=400

# --- Security & Rate Limiting ---
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_QUERIES_PER_HOUR=20
RATE_LIMIT_QUERIES_PER_MINUTE=5
RATE_LIMIT_UPLOADS_PER_HOUR=5
RATE_LIMIT_UPLOADS_PER_DAY=20
RATE_LIMIT_BYTES_PER_DAY=104857600
